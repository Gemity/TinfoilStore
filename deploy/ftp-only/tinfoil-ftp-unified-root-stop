#!/usr/bin/env python3
"""Lazy-unmount every bind mount under /srv/tinfoil-unified, deepest path first.

Robust against spaces / brackets / unicode in mount paths (decodes the
octal-escaped paths in /proc/mounts), which a plain shell loop gets wrong.
This is what prevents the cascade stale-mount failure seen on the old server.
"""
import subprocess

ROOT = "/srv/tinfoil-unified"


def mounts_under():
    out = []
    with open("/proc/mounts", "rb") as f:
        for line in f:
            parts = line.split(b" ")
            if len(parts) < 2:
                continue
            target = parts[1].decode("unicode_escape").encode("latin1").decode("utf-8", "replace")
            if target == ROOT or target.startswith(ROOT + "/"):
                out.append(target)
    return out


for target in sorted(mounts_under(), key=len, reverse=True):
    subprocess.run(["umount", "-l", target], stderr=subprocess.DEVNULL)
